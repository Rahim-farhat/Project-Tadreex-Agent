# Local development. Production values live in ../.env (see README).

# PostgreSQL (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgres://scenarios:scenarios@localhost:5435/scenarios

# Groq AI
GROQ_API_KEY=

# Long random string:  openssl rand -hex 64
JWT_SECRET=

PORT=5000
CLIENT_URL=http://localhost:3000

# Admin account created on first start if missing
ADMIN_EMAIL=admin@tadreex.com
ADMIN_PASSWORD=

# Only for `npm run migrate:mongo`
MONGODB_URI=
