# Copy to .env next to docker-compose.yml and fill in every value.
#   cp .env.example .env

# Public hostname. Its DNS A/AAAA record must point at the VPS.
DOMAIN=scenarios.tadreex.com

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=scenarios
POSTGRES_USER=scenarios
# URL-safe characters only (it is embedded in a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── API ─────────────────────────────────────────────────────
#   openssl rand -hex 64
JWT_SECRET=
GROQ_API_KEY=

# Admin account created on first start if it does not exist yet.
# Changing these later does NOT change an existing account.
ADMIN_EMAIL=admin@tadreex.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ─── One-off migration from MongoDB (optional) ───────────────
# Only needed to import the old data; remove it afterwards.
MONGODB_URI=
